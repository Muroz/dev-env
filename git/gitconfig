# Git global configuration
# This file should be symlinked to ~/.gitconfig

# Identity is NOT set here. This file is symlinked to ~/.gitconfig, and git
# follows that symlink when writing, so `git config --global user.email ...`
# would write your address into this tracked file and commit it.
#
# It lives in ~/.gitconfig.local instead, which the [include] at the end of
# this file pulls in. See git/gitconfig.local.example. The bootstrap script
# creates it.
#
# Note that `git config --global --get user.name` does not follow includes and
# will print nothing. Use `git config --get user.name`.

[core]
    # Use VS Code as default editor
    editor = code --wait

    # Handle line endings (input = convert CRLF to LF on commit, keep LF on checkout)
    autocrlf = input

    # Global gitignore file
	excludesfile = /Users/diegozuluaga/.gitignore_global

    # Prevent unnecessary commits with only whitespace changes
    whitespace = trailing-space,space-before-tab

    # Enable parallel I/O for better performance on large repos
    preloadIndex = true

[init]
    # Use 'main' as default branch name for new repositories
    defaultBranch = main

[pull]
    # Don't rebase when pulling (merge instead)
    rebase = false

    # Only allow fast-forward merges by default (prevents accidental merge commits)
    ff = only

[push]
    # Push current branch to remote branch with same name
    default = current

    # Automatically setup remote tracking when pushing new branches
    autoSetupRemote = true

    # Push tags along with commits when relevant
    followTags = true

[fetch]
    # Automatically prune deleted remote branches
    prune = true

    # Prune tags that no longer exist on remote
    pruneTags = true

[merge]
    # Include original in merge conflicts for better context
    conflictStyle = zdiff3

    # Create a merge commit even for fast-forward merges (for better history)
    ff = false

[rebase]
    # Automatically stash changes before rebasing
    autoStash = true

    # Automatically squash commits marked with 'fixup!' or 'squash!'
    autoSquash = true

[diff]
    # Better diff algorithm for more readable diffs
    algorithm = histogram

    # Show moved code in different color
    colorMoved = default

    # Detect renames and copies
    renames = copies

[status]
    # Show individual files in untracked directories
    showUntrackedFiles = all

    # Show submodule changes summary
    submoduleSummary = true

[commit]
    # Show diff in commit message editor
    verbose = true

    # Template for commit messages (optional - create ~/.gitmessage)
    # template = ~/.gitmessage

[log]
    # Show dates in relative format (e.g., "2 hours ago")
    date = relative

    # Automatically follow file renames in log
    follow = true

[color]
    # Enable colors in git output
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

[help]
    # Automatically correct mistyped commands after 1.5 seconds
    autocorrect = 15

[credential]
    # Cache credentials for 1 hour (macOS uses keychain by default)
    helper = cache --timeout=3600

# ============================================================================
# Aliases
# ============================================================================

[alias]
    # Status & Information
    st = status
    s = status -sb

    # Branching
    br = branch
    bra = branch -a
    brd = branch -d

    # Checkout & Switching
    co = checkout
    cob = checkout -b
    sw = switch
    swc = switch -c

    # Committing
    ci = commit
    cim = commit -m
    ca = commit --amend
    can = commit --amend --no-edit

    # Adding
    a = add
    aa = add --all
    ap = add --patch

    # Diffing
    d = diff
    ds = diff --staged
    dw = diff --word-diff

    # Logging
    l = log --oneline --decorate --graph -20
    ll = log --oneline --decorate --graph
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    last = log -1 HEAD --stat
    visual = log --oneline --graph --decorate --all

    # Stashing
    stash-all = stash save --include-untracked

    # Undoing
    unstage = reset HEAD --
    undo = reset --soft HEAD~1
    amend = commit --amend --no-edit

    # Remote operations
    f = fetch --all --prune
    pl = pull
    ps = push
    pf = push --force-with-lease

    # Utility
    alias = config --get-regexp ^alias\\.
    contributors = shortlog -sn
    recent = branch --sort=-committerdate --format='%(committerdate:relative)%09%(refname:short)'

    # Clean up merged branches
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

    # Show what would be pushed
    what = log --oneline origin/main..HEAD

    # Quick save work in progress
    wip = "!git add -A && git commit -m 'WIP: work in progress'"

    # Undo last commit but keep changes staged
    uncommit = reset --soft HEAD~1

# ============================================================================
# Platform-specific Settings (macOS)
# ============================================================================

# Use macOS Keychain for credential storage
[credential "https://github.com"]
    helper = osxkeychain

[credential "https://gitlab.com"]
    helper = osxkeychain

# ============================================================================
# Performance (for large repos)
# ============================================================================

[feature]
    # Enable multi-pack-index for better performance
    manyFiles = true

[index]
    # Use version 4 of the index format for better performance
    version = 4

# ============================================================================
# Delta (Optional - better diff viewer)
# ============================================================================
# Uncomment if you install 'delta' via: brew install git-delta
# [core]
#     pager = delta
#
# [interactive]
#     diffFilter = delta --color-only
#
# [delta]
#     navigate = true
#     light = false
#     side-by-side = true
#
# [merge]
#     conflictstyle = diff3

# ============================================================================
# Machine-local configuration
# ============================================================================
# Last, so anything here wins. Holds the git identity and any per-machine
# settings. Not tracked. Git ignores a missing include, so this is safe on a
# machine where the file does not exist yet.
[include]
    path = ~/.gitconfig.local
