# Environment Variables Template
# Copy this file to ~/.env.local and fill in your values
# Then source it in your shell: source ~/.env.local

# ============================================================================
# Git Identity
# ============================================================================
# These variables are used by the bootstrap script to configure git
export GIT_USER_NAME="Your Name"
export GIT_USER_EMAIL="your.email@example.com"

# ============================================================================
# Optional: API Keys and Secrets
# ============================================================================
# Add your API keys here (never commit the actual .env file!)
# export OPENAI_API_KEY="your-key-here"
# export ANTHROPIC_API_KEY="your-key-here"
# export GITHUB_TOKEN="your-token-here"

# ============================================================================
# Optional: Cloud Provider Credentials
# ============================================================================
# export AWS_ACCESS_KEY_ID="your-access-key"
# export AWS_SECRET_ACCESS_KEY="your-secret-key"
# export AWS_DEFAULT_REGION="us-east-1"

# ============================================================================
# Optional: Development Environment
# ============================================================================
# export NODE_ENV="development"
# export PYTHON_ENV="development"

# ============================================================================
# Usage Instructions
# ============================================================================
# 1. Copy this file: cp .env.example ~/.env.local
# 2. Fill in your actual values in ~/.env.local
# 3. Add to your .zshrc (optional): [ -f ~/.env.local ] && source ~/.env.local
# 4. Or source manually when needed: source ~/.env.local
